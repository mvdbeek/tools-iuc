<?xml version="1.0"?>
<tool id="gene_annotation_fetcher_data_manager" name="Gene Annotation Fetch" tool_type="manage_data" version="1.0.3" profile="23.0">
    <description>gene annotation fetcher</description>
    <requirements>
        <requirement type="package" version="3.8.3">python</requirement>
    </requirements>
    <command detect_errors="exit_code">
    <![CDATA[
        mkdir -p '$out_file.extra_files_path' &&
        cd '$out_file.extra_files_path' &&
        python '$__tool_directory__/data_manager.py' --out '${out_file}'
        #if $gene_annotation_url:
            --url '${gene_annotation_url}'
        #end if
        #if $database_name:
            --name '${database_name}'
        #end if
    ]]>
    </command>
    <inputs>
        <param name="database_name" type="text" optional="true" label="Name for this database" help="Enter a genome/build identifier, or leave blank to use a stable content-derived identifier" />
        <param name="gene_annotation_url" type="text" label="Enter URL for gene annotation files" />
    </inputs>
    <outputs>
        <data format="data_manager_json" name="out_file" />
    </outputs>
    <help>
    </help>
</tool>
