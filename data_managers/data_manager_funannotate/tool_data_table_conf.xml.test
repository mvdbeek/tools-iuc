<tables>
    <!-- Duplicates are allowed here, unlike in the production table: both tests
         install the same partial database (once with wget, once without), and the
         value is now derived from the database content, so the rows are identical. -->
    <table name="funannotate" comment_char="#" allow_duplicate_entries="True">
        <columns>value, description, format_version, path</columns>
        <file path="${__HERE__}/test-data/funannotate.loc" />
    </table>
</tables>
